{
  "name": "@gram-data/value",
  "version": "0.2.0",
  "description": "The data values of the gram notation: kinds, equality, canonical text, known-tag interpretation and mapping to JavaScript values",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gram-data/gram-value.git",
    "directory": "typescript"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@gram-data/tree-sitter-gram": "0.7.0",
    "@types/node": "^24.0.0",
    "tree-sitter": "^0.25.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "gram",
    "graph",
    "values"
  ],
  "homepage": "https://github.com/gram-data/gram-value/tree/main/typescript#readme",
  "bugs": {
    "url": "https://github.com/gram-data/gram-value/issues"
  }
}
