{
  "name": "gram-value",
  "version": "0.0.0",
  "description": "The data values of the gram notation: kinds, equality, canonical text, known-tag interpretation and mapping to JavaScript values",
  "license": "MIT",
  "repository": "github:gram-data/gram-value",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "devDependencies": {
    "@gram-data/tree-sitter-gram": "0.7.0",
    "@types/node": "^24.0.0",
    "tree-sitter": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
