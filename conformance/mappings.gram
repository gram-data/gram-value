// MappingCase: how a value maps to each language's native values (ADR-001 2.4, ADR-006).
// Only Rust has entries so far; a case with no entry for a language does not apply to it.

(map-integer-zero:MappingCase {name: "zero", value: 0, rust: {class: exact, loss: [], native: i64, roundtrip: "0"}})
(map-integer-max:MappingCase {name: "largest 64-bit integer", value: 9223372036854775807, rust: {class: exact, loss: [], native: i64, roundtrip: "9223372036854775807"}})
(map-integer-hex:MappingCase {name: "hexadecimal reads as an integer", value: 0x10, rust: {class: exact, loss: [], native: i64, roundtrip: "16"}})
(map-big-integer-u64:MappingCase {name: "a big integer that fits u64", value: 9223372036854775808, rust: {class: exact, loss: [], native: u64, roundtrip: "9223372036854775808"}})
(map-big-integer-i128:MappingCase {name: "a big integer that fits i128", value: -9223372036854775809, rust: {class: exact, loss: [], native: i128, roundtrip: "-9223372036854775809"}})
(map-big-integer-huge:MappingCase {name: "a big integer beyond 128 bits", value: 1000000000000000000000000000000000000000000, rust: {class: unsupported, native: none}})
(map-decimal:MappingCase {name: "a decimal is a float", value: 0.1, rust: {class: exact, loss: [], native: f64, roundtrip: "0.1"}})
(map-decimal-whole:MappingCase {name: "a whole decimal stays a decimal in Rust", value: 1.0, rust: {class: exact, loss: [], native: f64, roundtrip: "1.0"}})
(map-decimal-negative-zero:MappingCase {name: "negative zero", value: -0.0, rust: {class: exact, loss: [], native: f64, roundtrip: "-0.0"}})
(map-big-decimal:MappingCase {name: "a big decimal has no std type", value: 0.10000000000000000001, rust: {class: unsupported, native: none}})
(map-boolean:MappingCase {name: "a boolean", value: true, rust: {class: exact, loss: [], native: bool, roundtrip: "true"}})
(map-string:MappingCase {name: "a string", value: "Ada Lovelace", rust: {class: exact, loss: [], native: String, roundtrip: "\"Ada Lovelace\""}})
(map-tagged-unknown:MappingCase {name: "an unknown tag", value: ts`string`, rust: {class: exact, loss: [], native: Tagged, roundtrip: "ts`string`"}})
(map-range:MappingCase {name: "a range", value: 1.5m..2m, rust: {class: exact, loss: [], native: Range, roundtrip: "1.5m..2m"}})
(map-range-open:MappingCase {name: "an open range", value: 1..., rust: {class: exact, loss: [], native: Range, roundtrip: "1..."}})
(map-measurement:MappingCase {name: "a measurement", value: 5.0kg, rust: {class: exact, loss: [], native: Measurement, roundtrip: "5.0kg"}})
(map-array:MappingCase {name: "an array", value: [1, 2], rust: {class: exact, loss: [], native: Vec, roundtrip: "[1, 2]"}})
(map-array-empty:MappingCase {name: "the empty array", value: [], rust: {class: exact, loss: [], native: Vec, roundtrip: "[]"}})
(map-map:MappingCase {name: "a map", value: {b: 1, a: [1, 2]}, rust: {class: exact, loss: [], native: BTreeMap, roundtrip: "{a: [1, 2], b: 1}"}})
(map-date:MappingCase {name: "a date", value: date`2024-01-15`, rust: {class: exact, loss: [], native: Date, roundtrip: "date`2024-01-15`"}})
(map-time:MappingCase {name: "a time with normal content", value: time`17:35:00Z`, rust: {class: exact, loss: [], native: Time, roundtrip: "time`17:35:00Z`"}})
(map-datetime:MappingCase {name: "a datetime", value: datetime`2024-01-15T10:30:00+01:00[Europe/Paris]`, rust: {class: exact, loss: [], native: DateTime, roundtrip: "datetime`2024-01-15T10:30:00+01:00[Europe/Paris]`"}})
(map-duration:MappingCase {name: "a duration", value: duration`PT2H3M42S`, rust: {class: exact, loss: [], native: Duration, roundtrip: "duration`PT2H3M42S`"}})
(map-point:MappingCase {name: "a point", value: point`SRID=4326;12.5 55.7`, rust: {class: exact, loss: [], native: Point, roundtrip: "point`SRID=4326;12.5 55.7`"}})
(map-uuid:MappingCase {name: "a uuid", value: uuid`123e4567-e89b-12d3-a456-426614174000`, rust: {class: exact, loss: [], native: Uuid, roundtrip: "uuid`123e4567-e89b-12d3-a456-426614174000`"}})
(map-week:MappingCase {name: "a week", value: week`2024W35`, rust: {class: exact, loss: [], native: Week, roundtrip: "week`2024W35`"}})
