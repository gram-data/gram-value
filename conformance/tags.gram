// TagCase: interpreting the tag of `value` is accepted or rejected (ADR-001 2.4, spec/tags.md).
// An accepted case states the normal content string in `interpreted`.

(tag-date:TagCase {name: "a leap day", value: date`2024-02-29`, outcome: accepted, interpreted: "2024-02-29"})
(tag-date-not-leap:TagCase {name: "29 February in a common year", value: date`2023-02-29`, outcome: rejected, diagnostic: out-of-range})
(tag-date-century:TagCase {name: "1900 is not a leap year", value: date`1900-02-29`, outcome: rejected, diagnostic: out-of-range})
(tag-date-400:TagCase {name: "2000 is a leap year", value: date`2000-02-29`, outcome: accepted, interpreted: "2000-02-29"})
(tag-date-month:TagCase {name: "month 13", value: date`2024-13-01`, outcome: rejected, diagnostic: out-of-range})
(tag-date-short:TagCase {name: "one-digit month and day", value: date`2024-1-5`, outcome: rejected, diagnostic: invalid-form})
(tag-date-basic:TagCase {name: "basic format", value: date`20240115`, outcome: rejected, diagnostic: invalid-form})
(tag-date-negative:TagCase {name: "a negative year", value: date`-0044-03-15`, outcome: accepted, interpreted: "-0044-03-15"})

(tag-time-minutes:TagCase {name: "hours and minutes", value: time`17:35`, outcome: accepted, interpreted: "17:35:00"})
(tag-time-fraction:TagCase {name: "a fraction", value: time`17:42:03.149`, outcome: accepted, interpreted: "17:42:03.149"})
(tag-time-fraction-zeros:TagCase {name: "trailing zeros of a fraction drop", value: time`17:42:03.500`, outcome: accepted, interpreted: "17:42:03.5"})
(tag-time-zero-fraction:TagCase {name: "an all-zero fraction is dropped", value: time`17:42:03.000`, outcome: accepted, interpreted: "17:42:03"})
(tag-time-utc:TagCase {name: "Z", value: time`17:42Z`, outcome: accepted, interpreted: "17:42:00Z"})
(tag-time-plus-zero:TagCase {name: "+00:00 is written Z", value: time`17:42:00+00:00`, outcome: accepted, interpreted: "17:42:00Z"})
(tag-time-offset:TagCase {name: "a positive offset", value: time`17:42+01:00`, outcome: accepted, interpreted: "17:42:00+01:00"})
(tag-time-hour-24:TagCase {name: "hour 24", value: time`24:00:00`, outcome: rejected, diagnostic: out-of-range})
(tag-time-second-60:TagCase {name: "second 60", value: time`10:00:60`, outcome: rejected, diagnostic: out-of-range})
(tag-time-offset-range:TagCase {name: "offset of 24 hours", value: time`10:00+24:00`, outcome: rejected, diagnostic: out-of-range})
(tag-time-fraction-long:TagCase {name: "ten fraction digits", value: time`10:00:00.0123456789`, outcome: rejected, diagnostic: invalid-form})
(tag-time-fraction-no-seconds:TagCase {name: "a fraction needs seconds", value: time`10:00.5`, outcome: rejected, diagnostic: invalid-form})
(tag-localtime:TagCase {name: "a local time", value: localtime`10:30:00`, outcome: accepted, interpreted: "10:30:00"})
(tag-localtime-offset:TagCase {name: "an offset is not allowed", value: localtime`10:30:00Z`, outcome: rejected, diagnostic: invalid-form})

(tag-datetime-zone:TagCase {name: "an offset and a zone name", value: datetime`2024-01-15T10:30:00+01:00[Europe/Paris]`, outcome: accepted, interpreted: "2024-01-15T10:30:00+01:00[Europe/Paris]"})
(tag-datetime-no-offset:TagCase {name: "the offset is optional", value: datetime`2024-01-15T10:30`, outcome: accepted, interpreted: "2024-01-15T10:30:00"})
(tag-datetime-zone-no-offset:TagCase {name: "a zone name needs an offset", value: datetime`2024-01-15T10:30:00[Europe/Paris]`, outcome: rejected, diagnostic: invalid-form})
(tag-datetime-bare-date:TagCase {name: "a bare date", value: datetime`2024-01-15`, outcome: rejected, diagnostic: invalid-form})
(tag-localdatetime:TagCase {name: "a local datetime", value: localdatetime`2024-01-15T10:30:00`, outcome: accepted, interpreted: "2024-01-15T10:30:00"})
(tag-localdatetime-offset:TagCase {name: "an offset is not allowed", value: localdatetime`2024-01-15T10:30:00Z`, outcome: rejected, diagnostic: invalid-form})

(tag-duration:TagCase {name: "hours, minutes and seconds", value: duration`PT2H3M42S`, outcome: accepted, interpreted: "PT2H3M42S"})
(tag-duration-signs:TagCase {name: "signs per number", value: duration`P1DT-2H`, outcome: accepted, interpreted: "P1DT-2H"})
(tag-duration-fraction:TagCase {name: "a fraction of seconds", value: duration`PT0.5S`, outcome: accepted, interpreted: "PT0.5S"})
(tag-duration-weeks:TagCase {name: "weeks are not accepted", value: duration`P1W`, outcome: rejected, diagnostic: invalid-form})
(tag-duration-empty:TagCase {name: "no component", value: duration`P`, outcome: rejected, diagnostic: invalid-form})
(tag-duration-lone-t:TagCase {name: "T without a component", value: duration`P1DT`, outcome: rejected, diagnostic: invalid-form})
(tag-duration-order:TagCase {name: "components out of order", value: duration`P1D1Y`, outcome: rejected, diagnostic: invalid-form})

(tag-point:TagCase {name: "two coordinates", value: point`30 10`, outcome: accepted, interpreted: "30 10"})
(tag-point-z:TagCase {name: "three coordinates", value: point`30 10 5`, outcome: accepted, interpreted: "30 10 5"})
(tag-point-normal:TagCase {name: "numbers are written shortest", value: point`30.0 -0`, outcome: accepted, interpreted: "30 0"})
(tag-point-large:TagCase {name: "a large coordinate is written without an exponent", value: point`1000000000000000000000 0.0000001`, outcome: accepted, interpreted: "1000000000000000000000 0.0000001"})
(tag-point-srid:TagCase {name: "an SRID prefix", value: point`SRID=4326;12.5 55.7`, outcome: accepted, interpreted: "SRID=4326;12.5 55.7"})
(tag-point-one:TagCase {name: "one coordinate", value: point`30`, outcome: rejected, diagnostic: invalid-form})
(tag-point-four:TagCase {name: "four coordinates", value: point`1 2 3 4`, outcome: rejected, diagnostic: invalid-form})
(tag-point-plus:TagCase {name: "a plus sign", value: point`+1 2`, outcome: rejected, diagnostic: invalid-form})
(tag-point-wkt:TagCase {name: "well-known text is not this form", value: point`POINT(1 2)`, outcome: rejected, diagnostic: invalid-form})

(tag-uuid:TagCase {name: "upper case is normalized to lower", value: uuid`123E4567-E89B-12D3-A456-426614174000`, outcome: accepted, interpreted: "123e4567-e89b-12d3-a456-426614174000"})
(tag-uuid-short:TagCase {name: "a group too short", value: uuid`123e4567-e89b-12d3-a456-42661417400`, outcome: rejected, diagnostic: invalid-form})
(tag-uuid-nonhex:TagCase {name: "a non-hexadecimal digit", value: uuid`123e4567-e89b-12d3-a456-42661417400g`, outcome: rejected, diagnostic: invalid-form})

(tag-week:TagCase {name: "a week", value: week`2024W35`, outcome: accepted, interpreted: "2024W35"})
(tag-week-53:TagCase {name: "2020 has 53 weeks", value: week`2020W53`, outcome: accepted, interpreted: "2020W53"})
(tag-week-53-none:TagCase {name: "2021 has 52 weeks", value: week`2021W53`, outcome: rejected, diagnostic: out-of-range})
(tag-week-0:TagCase {name: "week 0", value: week`2024W00`, outcome: rejected, diagnostic: out-of-range})
(tag-week-form:TagCase {name: "a missing W", value: week`2024-35`, outcome: rejected, diagnostic: invalid-form})
(tag-weekdate:TagCase {name: "a week date", value: weekDate`2024W35-5`, outcome: accepted, interpreted: "2024W35-5"})
(tag-weekdate-8:TagCase {name: "weekday 8", value: weekDate`2024W35-8`, outcome: rejected, diagnostic: out-of-range})
(tag-weekdate-0:TagCase {name: "weekday 0", value: weekDate`2024W35-0`, outcome: rejected, diagnostic: out-of-range})

// embedding (ADR-008). These three are the output of the reference SafeTensors writer (the `safetensors` Python
// package 0.8.0, `safetensors.numpy.save({"embedding": array})`), so each normal content string equals its input:
// F32 [1.0, -2.0], F64 [0.0, 1.0, 2.0], F16 [0.0, 1.0, 2.0, 3.0, 4.0].
(tag-embedding-ref-f32:TagCase {name: "reference writer output, F32", value: embedding`QAAAAAAAAAB7ImVtYmVkZGluZyI6eyJkdHlwZSI6IkYzMiIsInNoYXBlIjpbMl0sImRhdGFfb2Zmc2V0cyI6WzAsOF19fSAgAACAPwAAAMA=`, outcome: accepted, interpreted: "QAAAAAAAAAB7ImVtYmVkZGluZyI6eyJkdHlwZSI6IkYzMiIsInNoYXBlIjpbMl0sImRhdGFfb2Zmc2V0cyI6WzAsOF19fSAgAACAPwAAAMA="})
(tag-embedding-ref-f64:TagCase {name: "reference writer output, F64", value: embedding`QAAAAAAAAAB7ImVtYmVkZGluZyI6eyJkdHlwZSI6IkY2NCIsInNoYXBlIjpbM10sImRhdGFfb2Zmc2V0cyI6WzAsMjRdfX0gAAAAAAAAAAAAAAAAAADwPwAAAAAAAABA`, outcome: accepted, interpreted: "QAAAAAAAAAB7ImVtYmVkZGluZyI6eyJkdHlwZSI6IkY2NCIsInNoYXBlIjpbM10sImRhdGFfb2Zmc2V0cyI6WzAsMjRdfX0gAAAAAAAAAAAAAAAAAADwPwAAAAAAAABA"})
(tag-embedding-ref-f16:TagCase {name: "reference writer output, F16", value: embedding`QAAAAAAAAAB7ImVtYmVkZGluZyI6eyJkdHlwZSI6IkYxNiIsInNoYXBlIjpbNV0sImRhdGFfb2Zmc2V0cyI6WzAsMTBdfX0gAAAAPABAAEIARA==`, outcome: accepted, interpreted: "QAAAAAAAAAB7ImVtYmVkZGluZyI6eyJkdHlwZSI6IkYxNiIsInNoYXBlIjpbNV0sImRhdGFfb2Zmc2V0cyI6WzAsMTBdfX0gAAAAPABAAEIARA=="})
