// TagCase: interpreting the tag of `value` is accepted or rejected (ADR-001 2.4, spec/tags.md).
// An accepted case states the normal content string in `interpreted`.

(tag-date:TagCase {name: "a leap day", value: date`2024-02-29`, outcome: accepted, interpreted: "2024-02-29"})
(tag-date-not-leap:TagCase {name: "29 February in a common year", value: date`2023-02-29`, outcome: rejected, diagnostic: out-of-range})
(tag-date-century:TagCase {name: "1900 is not a leap year", value: date`1900-02-29`, outcome: rejected, diagnostic: out-of-range})
(tag-date-400:TagCase {name: "2000 is a leap year", value: date`2000-02-29`, outcome: accepted, interpreted: "2000-02-29"})
(tag-date-month:TagCase {name: "month 13", value: date`2024-13-01`, outcome: rejected, diagnostic: out-of-range})
(tag-date-short:TagCase {name: "one-digit month and day", value: date`2024-1-5`, outcome: rejected, diagnostic: invalid-form})
(tag-date-basic:TagCase {name: "basic format", value: date`20240115`, outcome: rejected, diagnostic: invalid-form})
(tag-date-negative:TagCase {name: "a negative year", value: date`-0044-03-15`, outcome: accepted, interpreted: "-0044-03-15"})

(tag-time-minutes:TagCase {name: "hours and minutes", value: time`17:35`, outcome: accepted, interpreted: "17:35:00"})
(tag-time-fraction:TagCase {name: "a fraction", value: time`17:42:03.149`, outcome: accepted, interpreted: "17:42:03.149"})
(tag-time-fraction-zeros:TagCase {name: "trailing zeros of a fraction drop", value: time`17:42:03.500`, outcome: accepted, interpreted: "17:42:03.5"})
(tag-time-zero-fraction:TagCase {name: "an all-zero fraction is dropped", value: time`17:42:03.000`, outcome: accepted, interpreted: "17:42:03"})
(tag-time-utc:TagCase {name: "Z", value: time`17:42Z`, outcome: accepted, interpreted: "17:42:00Z"})
(tag-time-plus-zero:TagCase {name: "+00:00 is written Z", value: time`17:42:00+00:00`, outcome: accepted, interpreted: "17:42:00Z"})
(tag-time-offset:TagCase {name: "a positive offset", value: time`17:42+01:00`, outcome: accepted, interpreted: "17:42:00+01:00"})
(tag-time-hour-24:TagCase {name: "hour 24", value: time`24:00:00`, outcome: rejected, diagnostic: out-of-range})
(tag-time-second-60:TagCase {name: "second 60", value: time`10:00:60`, outcome: rejected, diagnostic: out-of-range})
(tag-time-offset-range:TagCase {name: "offset of 24 hours", value: time`10:00+24:00`, outcome: rejected, diagnostic: out-of-range})
(tag-time-fraction-long:TagCase {name: "ten fraction digits", value: time`10:00:00.0123456789`, outcome: rejected, diagnostic: invalid-form})
(tag-time-fraction-no-seconds:TagCase {name: "a fraction needs seconds", value: time`10:00.5`, outcome: rejected, diagnostic: invalid-form})
(tag-localtime:TagCase {name: "a local time", value: localtime`10:30:00`, outcome: accepted, interpreted: "10:30:00"})
(tag-localtime-offset:TagCase {name: "an offset is not allowed", value: localtime`10:30:00Z`, outcome: rejected, diagnostic: invalid-form})

(tag-datetime-zone:TagCase {name: "an offset and a zone name", value: datetime`2024-01-15T10:30:00+01:00[Europe/Paris]`, outcome: accepted, interpreted: "2024-01-15T10:30:00+01:00[Europe/Paris]"})
(tag-datetime-no-offset:TagCase {name: "the offset is optional", value: datetime`2024-01-15T10:30`, outcome: accepted, interpreted: "2024-01-15T10:30:00"})
(tag-datetime-zone-no-offset:TagCase {name: "a zone name needs an offset", value: datetime`2024-01-15T10:30:00[Europe/Paris]`, outcome: rejected, diagnostic: invalid-form})
(tag-datetime-bare-date:TagCase {name: "a bare date", value: datetime`2024-01-15`, outcome: rejected, diagnostic: invalid-form})
(tag-localdatetime:TagCase {name: "a local datetime", value: localdatetime`2024-01-15T10:30:00`, outcome: accepted, interpreted: "2024-01-15T10:30:00"})
(tag-localdatetime-offset:TagCase {name: "an offset is not allowed", value: localdatetime`2024-01-15T10:30:00Z`, outcome: rejected, diagnostic: invalid-form})

(tag-duration:TagCase {name: "hours, minutes and seconds", value: duration`PT2H3M42S`, outcome: accepted, interpreted: "PT2H3M42S"})
(tag-duration-signs:TagCase {name: "signs per number", value: duration`P1DT-2H`, outcome: accepted, interpreted: "P1DT-2H"})
(tag-duration-fraction:TagCase {name: "a fraction of seconds", value: duration`PT0.5S`, outcome: accepted, interpreted: "PT0.5S"})
(tag-duration-weeks:TagCase {name: "weeks are not accepted", value: duration`P1W`, outcome: rejected, diagnostic: invalid-form})
(tag-duration-empty:TagCase {name: "no component", value: duration`P`, outcome: rejected, diagnostic: invalid-form})
(tag-duration-lone-t:TagCase {name: "T without a component", value: duration`P1DT`, outcome: rejected, diagnostic: invalid-form})
(tag-duration-order:TagCase {name: "components out of order", value: duration`P1D1Y`, outcome: rejected, diagnostic: invalid-form})

(tag-point:TagCase {name: "two coordinates", value: point`30 10`, outcome: accepted, interpreted: "30 10"})
(tag-point-z:TagCase {name: "three coordinates", value: point`30 10 5`, outcome: accepted, interpreted: "30 10 5"})
(tag-point-normal:TagCase {name: "numbers are written shortest", value: point`30.0 -0`, outcome: accepted, interpreted: "30 0"})
(tag-point-large:TagCase {name: "a large coordinate is written without an exponent", value: point`1000000000000000000000 0.0000001`, outcome: accepted, interpreted: "1000000000000000000000 0.0000001"})
(tag-point-srid:TagCase {name: "an SRID prefix", value: point`SRID=4326;12.5 55.7`, outcome: accepted, interpreted: "SRID=4326;12.5 55.7"})
(tag-point-one:TagCase {name: "one coordinate", value: point`30`, outcome: rejected, diagnostic: invalid-form})
(tag-point-four:TagCase {name: "four coordinates", value: point`1 2 3 4`, outcome: rejected, diagnostic: invalid-form})
(tag-point-plus:TagCase {name: "a plus sign", value: point`+1 2`, outcome: rejected, diagnostic: invalid-form})
(tag-point-wkt:TagCase {name: "well-known text is not this form", value: point`POINT(1 2)`, outcome: rejected, diagnostic: invalid-form})

(tag-uuid:TagCase {name: "upper case is normalized to lower", value: uuid`123E4567-E89B-12D3-A456-426614174000`, outcome: accepted, interpreted: "123e4567-e89b-12d3-a456-426614174000"})
(tag-uuid-short:TagCase {name: "a group too short", value: uuid`123e4567-e89b-12d3-a456-42661417400`, outcome: rejected, diagnostic: invalid-form})
(tag-uuid-nonhex:TagCase {name: "a non-hexadecimal digit", value: uuid`123e4567-e89b-12d3-a456-42661417400g`, outcome: rejected, diagnostic: invalid-form})

(tag-week:TagCase {name: "a week", value: week`2024W35`, outcome: accepted, interpreted: "2024W35"})
(tag-week-53:TagCase {name: "2020 has 53 weeks", value: week`2020W53`, outcome: accepted, interpreted: "2020W53"})
(tag-week-53-none:TagCase {name: "2021 has 52 weeks", value: week`2021W53`, outcome: rejected, diagnostic: out-of-range})
(tag-week-0:TagCase {name: "week 0", value: week`2024W00`, outcome: rejected, diagnostic: out-of-range})
(tag-week-form:TagCase {name: "a missing W", value: week`2024-35`, outcome: rejected, diagnostic: invalid-form})
(tag-weekdate:TagCase {name: "a week date", value: weekDate`2024W35-5`, outcome: accepted, interpreted: "2024W35-5"})
(tag-weekdate-8:TagCase {name: "weekday 8", value: weekDate`2024W35-8`, outcome: rejected, diagnostic: out-of-range})
(tag-weekdate-0:TagCase {name: "weekday 0", value: weekDate`2024W35-0`, outcome: rejected, diagnostic: out-of-range})

// embedding (ADR-008). These three are the output of the reference SafeTensors writer (the `safetensors` Python
// package 0.8.0, `safetensors.numpy.save({"embedding": array})`), so each normal content string equals its input:
// F32 [1.0, -2.0], F64 [0.0, 1.0, 2.0], F16 [0.0, 1.0, 2.0, 3.0, 4.0].
(tag-embedding-ref-f32:TagCase {name: "reference writer output, F32", value: embedding`QAAAAAAAAAB7ImVtYmVkZGluZyI6eyJkdHlwZSI6IkYzMiIsInNoYXBlIjpbMl0sImRhdGFfb2Zmc2V0cyI6WzAsOF19fSAgAACAPwAAAMA=`, outcome: accepted, interpreted: "QAAAAAAAAAB7ImVtYmVkZGluZyI6eyJkdHlwZSI6IkYzMiIsInNoYXBlIjpbMl0sImRhdGFfb2Zmc2V0cyI6WzAsOF19fSAgAACAPwAAAMA="})
(tag-embedding-ref-f64:TagCase {name: "reference writer output, F64", value: embedding`QAAAAAAAAAB7ImVtYmVkZGluZyI6eyJkdHlwZSI6IkY2NCIsInNoYXBlIjpbM10sImRhdGFfb2Zmc2V0cyI6WzAsMjRdfX0gAAAAAAAAAAAAAAAAAADwPwAAAAAAAABA`, outcome: accepted, interpreted: "QAAAAAAAAAB7ImVtYmVkZGluZyI6eyJkdHlwZSI6IkY2NCIsInNoYXBlIjpbM10sImRhdGFfb2Zmc2V0cyI6WzAsMjRdfX0gAAAAAAAAAAAAAAAAAADwPwAAAAAAAABA"})
(tag-embedding-ref-f16:TagCase {name: "reference writer output, F16", value: embedding`QAAAAAAAAAB7ImVtYmVkZGluZyI6eyJkdHlwZSI6IkYxNiIsInNoYXBlIjpbNV0sImRhdGFfb2Zmc2V0cyI6WzAsMTBdfX0gAAAAPABAAEIARA==`, outcome: accepted, interpreted: "QAAAAAAAAAB7ImVtYmVkZGluZyI6eyJkdHlwZSI6IkYxNiIsInNoYXBlIjpbNV0sImRhdGFfb2Zmc2V0cyI6WzAsMTBdfX0gAAAAPABAAEIARA=="})

// embedding: header number and dtype spelling (ADR-008 2.2). Each buffer is otherwise consistent.
(tag-embedding-shape-float:TagCase {name: "a dimension written as 2.0", value: embedding`QAAAAAAAAAB7ImVtYmVkZGluZyI6eyJkdHlwZSI6IkYzMiIsInNoYXBlIjpbMi4wXSwiZGF0YV9vZmZzZXRzIjpbMCw4XX19AACAPwAAAEA=`, outcome: rejected, diagnostic: invalid-form})
(tag-embedding-shape-exponent:TagCase {name: "a dimension written as 1e1", value: embedding`SAAAAAAAAAB7ImVtYmVkZGluZyI6eyJkdHlwZSI6IkYzMiIsInNoYXBlIjpbMWUxXSwiZGF0YV9vZmZzZXRzIjpbMCw0MF19fSAgICAgICAAAAAAAACAPwAAAEAAAEBAAACAQAAAoEAAAMBAAADgQAAAAEEAABBB`, outcome: rejected, diagnostic: invalid-form})
(tag-embedding-shape-leading-zero:TagCase {name: "a dimension with a leading zero", value: embedding`QAAAAAAAAAB7ImVtYmVkZGluZyI6eyJkdHlwZSI6IkYzMiIsInNoYXBlIjpbMDJdLCJkYXRhX29mZnNldHMiOlswLDhdfX0gAACAPwAAAEA=`, outcome: rejected, diagnostic: invalid-form})
(tag-embedding-dtype-case:TagCase {name: "a dtype in lower case", value: embedding`QAAAAAAAAAB7ImVtYmVkZGluZyI6eyJkdHlwZSI6ImYzMiIsInNoYXBlIjpbMl0sImRhdGFfb2Zmc2V0cyI6WzAsOF19fSAgAACAPwAAAEA=`, outcome: rejected, diagnostic: unsupported})
(tag-embedding-shape-huge:TagCase {name: "a dimension beyond 64 bits", value: embedding`WAAAAAAAAAB7ImVtYmVkZGluZyI6eyJkdHlwZSI6IkYzMiIsInNoYXBlIjpbMTg0NDY3NDQwNzM3MDk1NTE2MTZdLCJkYXRhX29mZnNldHMiOlswLDhdfX0gICAgICAgAACAPwAAAEA=`, outcome: rejected, diagnostic: out-of-range})

// embedding: full profile coverage (ADR-008 2.2-2.4, 2.7).
(tag-embedding-bf16:TagCase {name: "BF16 embedding", value: embedding`QAAAAAAAAAB7ImVtYmVkZGluZyI6eyJkdHlwZSI6IkJGMTYiLCJzaGFwZSI6WzJdLCJkYXRhX29mZnNldHMiOlswLDRdfX0ggD8AwA==`, outcome: accepted, interpreted: "QAAAAAAAAAB7ImVtYmVkZGluZyI6eyJkdHlwZSI6IkJGMTYiLCJzaGFwZSI6WzJdLCJkYXRhX29mZnNldHMiOlswLDRdfX0ggD8AwA=="})
(tag-embedding-nonnormal:TagCase {name: "non-normal key order and whitespace", value: embedding`TwAAAAAAAAB7ICJlbWJlZGRpbmciIDogeyAic2hhcGUiIDogWzJdICwgImRhdGFfb2Zmc2V0cyIgOiBbMCwgOF0gLCAiZHR5cGUiIDogIkYzMiIgfSB9AACAPwAAAMA=`, outcome: accepted, interpreted: "QAAAAAAAAAB7ImVtYmVkZGluZyI6eyJkdHlwZSI6IkYzMiIsInNoYXBlIjpbMl0sImRhdGFfb2Zmc2V0cyI6WzAsOF19fSAgAACAPwAAAMA="})
(tag-embedding-ieee-bits:TagCase {name: "signed zero, infinities, and NaN payload", value: embedding`QAAAAAAAAAB7ImVtYmVkZGluZyI6eyJkdHlwZSI6IkYzMiIsInNoYXBlIjpbNF0sImRhdGFfb2Zmc2V0cyI6WzAsMTZdfX0gAAAAgAAAgH8AAID/AQDAfw==`, outcome: accepted, interpreted: "QAAAAAAAAAB7ImVtYmVkZGluZyI6eyJkdHlwZSI6IkYzMiIsInNoYXBlIjpbNF0sImRhdGFfb2Zmc2V0cyI6WzAsMTZdfX0gAAAAgAAAgH8AAID/AQDAfw=="})
(tag-embedding-dim-1:TagCase {name: "minimum dimension 1", value: embedding`QAAAAAAAAAB7ImVtYmVkZGluZyI6eyJkdHlwZSI6IkYzMiIsInNoYXBlIjpbMV0sImRhdGFfb2Zmc2V0cyI6WzAsNF19fSAgAAAAPw==`, outcome: accepted, interpreted: "QAAAAAAAAAB7ImVtYmVkZGluZyI6eyJkdHlwZSI6IkYzMiIsInNoYXBlIjpbMV0sImRhdGFfb2Zmc2V0cyI6WzAsNF19fSAgAAAAPw=="})
(tag-embedding-empty:TagCase {name: "empty content", value: embedding``, outcome: rejected, diagnostic: invalid-form})
(tag-embedding-b64-bad-char:TagCase {name: "invalid Base64 character", value: embedding`QAAA!`, outcome: rejected, diagnostic: invalid-form})
(tag-embedding-b64-whitespace:TagCase {name: "whitespace in Base64", value: embedding`AAAA AAAA`, outcome: rejected, diagnostic: invalid-form})
(tag-embedding-b64-pad-bits:TagCase {name: "non-zero Base64 pad bits", value: embedding`AB==`, outcome: rejected, diagnostic: invalid-form})
(tag-embedding-short-buf:TagCase {name: "buffer shorter than 8 bytes", value: embedding`AAAAAA==`, outcome: rejected, diagnostic: invalid-form})
(tag-embedding-hdr-4097:TagCase {name: "header length 4097 exceeds limit", value: embedding``, outcome: rejected, diagnostic: invalid-form})
(tag-embedding-hdr-trunc:TagCase {name: "header length exceeds remaining bytes", value: embedding`ZAAAAAAAAAB7fQ==`, outcome: rejected, diagnostic: invalid-form})
(tag-embedding-hdr-utf8:TagCase {name: "invalid UTF-8 in header", value: embedding`DwAAAAAAAAB7ImVtYmVkZGluZyI6/30=`, outcome: rejected, diagnostic: invalid-form})
(tag-embedding-hdr-json:TagCase {name: "malformed JSON header", value: embedding`DQAAAAAAAAB7ImVtYmVkZGluZyI6`, outcome: rejected, diagnostic: invalid-form})
(tag-embedding-dup-top:TagCase {name: "duplicate top-level JSON key", value: embedding`ewAAAAAAAAB7ImVtYmVkZGluZyI6eyJkdHlwZSI6IkYzMiIsInNoYXBlIjpbMl0sImRhdGFfb2Zmc2V0cyI6WzAsOF19LCJlbWJlZGRpbmciOnsiZHR5cGUiOiJGMzIiLCJzaGFwZSI6WzJdLCJkYXRhX29mZnNldHMiOlswLDhdfX0AAIA/AAAAwA==`, outcome: rejected, diagnostic: invalid-form})
(tag-embedding-dup-inner:TagCase {name: "duplicate inner JSON key", value: embedding`TAAAAAAAAAB7ImVtYmVkZGluZyI6eyJkdHlwZSI6IkYzMiIsImR0eXBlIjoiRjMyIiwic2hhcGUiOlsyXSwiZGF0YV9vZmZzZXRzIjpbMCw4XX19AACAPwAAAMA=`, outcome: rejected, diagnostic: invalid-form})
(tag-embedding-metadata:TagCase {name: "header with __metadata__", value: embedding`UAAAAAAAAAB7Il9fbWV0YWRhdGFfXyI6e30sImVtYmVkZGluZyI6eyJkdHlwZSI6IkYzMiIsInNoYXBlIjpbMl0sImRhdGFfb2Zmc2V0cyI6WzAsOF19fQAAgD8AAADA`, outcome: rejected, diagnostic: invalid-form})
(tag-embedding-extra-top:TagCase {name: "extra top-level key", value: embedding`dwAAAAAAAAB7ImVtYmVkZGluZyI6eyJkdHlwZSI6IkYzMiIsInNoYXBlIjpbMl0sImRhdGFfb2Zmc2V0cyI6WzAsOF19LCJvdGhlciI6eyJkdHlwZSI6IkYzMiIsInNoYXBlIjpbMl0sImRhdGFfb2Zmc2V0cyI6WzAsOF19fQAAgD8AAADA`, outcome: rejected, diagnostic: invalid-form})
(tag-embedding-wrong-name:TagCase {name: "wrong tensor name", value: embedding`OwAAAAAAAAB7InZlY3RvciI6eyJkdHlwZSI6IkYzMiIsInNoYXBlIjpbMl0sImRhdGFfb2Zmc2V0cyI6WzAsOF19fQAAgD8AAADA`, outcome: rejected, diagnostic: invalid-form})
(tag-embedding-missing-key:TagCase {name: "missing data_offsets key", value: embedding`KQAAAAAAAAB7ImVtYmVkZGluZyI6eyJkdHlwZSI6IkYzMiIsInNoYXBlIjpbMl19fQAAgD8AAADA`, outcome: rejected, diagnostic: invalid-form})
(tag-embedding-extra-inner:TagCase {name: "extra inner tensor key", value: embedding`SAAAAAAAAAB7ImVtYmVkZGluZyI6eyJkdHlwZSI6IkYzMiIsInNoYXBlIjpbMl0sImRhdGFfb2Zmc2V0cyI6WzAsOF0sImV4dHJhIjoxfX0AAIA/AAAAwA==`, outcome: rejected, diagnostic: invalid-form})
(tag-embedding-rank-0:TagCase {name: "zero-dimensional shape", value: embedding`PQAAAAAAAAB7ImVtYmVkZGluZyI6eyJkdHlwZSI6IkYzMiIsInNoYXBlIjpbXSwiZGF0YV9vZmZzZXRzIjpbMCwwXX19`, outcome: rejected, diagnostic: invalid-form})
(tag-embedding-rank-2:TagCase {name: "two-dimensional shape", value: embedding`QAAAAAAAAAB7ImVtYmVkZGluZyI6eyJkdHlwZSI6IkYzMiIsInNoYXBlIjpbMSwyXSwiZGF0YV9vZmZzZXRzIjpbMCw4XX19AACAPwAAAMA=`, outcome: rejected, diagnostic: invalid-form})
(tag-embedding-shape-neg:TagCase {name: "negative dimension", value: embedding`PwAAAAAAAAB7ImVtYmVkZGluZyI6eyJkdHlwZSI6IkYzMiIsInNoYXBlIjpbLTFdLCJkYXRhX29mZnNldHMiOlswLDhdfX0AAIA/AAAAwA==`, outcome: rejected, diagnostic: invalid-form})
(tag-embedding-offsets-nz:TagCase {name: "non-zero start offset", value: embedding`PgAAAAAAAAB7ImVtYmVkZGluZyI6eyJkdHlwZSI6IkYzMiIsInNoYXBlIjpbMl0sImRhdGFfb2Zmc2V0cyI6WzEsOV19fQAAgD8AAADA`, outcome: rejected, diagnostic: invalid-form})
(tag-embedding-offsets-bad:TagCase {name: "mismatched end offset", value: embedding`PgAAAAAAAAB7ImVtYmVkZGluZyI6eyJkdHlwZSI6IkYzMiIsInNoYXBlIjpbMl0sImRhdGFfb2Zmc2V0cyI6WzAsNF19fQAAgD8AAADA`, outcome: rejected, diagnostic: invalid-form})
(tag-embedding-trailing:TagCase {name: "trailing payload bytes", value: embedding`PgAAAAAAAAB7ImVtYmVkZGluZyI6eyJkdHlwZSI6IkYzMiIsInNoYXBlIjpbMl0sImRhdGFfb2Zmc2V0cyI6WzAsOF19fQAAgD8AAADAAA==`, outcome: rejected, diagnostic: invalid-form})
(tag-embedding-missing-bytes:TagCase {name: "missing payload bytes", value: embedding`PgAAAAAAAAB7ImVtYmVkZGluZyI6eyJkdHlwZSI6IkYzMiIsInNoYXBlIjpbMl0sImRhdGFfb2Zmc2V0cyI6WzAsOF19fQAAgD8AAAA=`, outcome: rejected, diagnostic: invalid-form})
(tag-embedding-shape-zero:TagCase {name: "dimension zero", value: embedding`PgAAAAAAAAB7ImVtYmVkZGluZyI6eyJkdHlwZSI6IkYzMiIsInNoYXBlIjpbMF0sImRhdGFfb2Zmc2V0cyI6WzAsMF19fQ==`, outcome: rejected, diagnostic: out-of-range})
(tag-embedding-shape-over-max:TagCase {name: "dimension exceeds 1048576", value: embedding`SgAAAAAAAAB7ImVtYmVkZGluZyI6eyJkdHlwZSI6IkYzMiIsInNoYXBlIjpbMTA0ODU3N10sImRhdGFfb2Zmc2V0cyI6WzAsNDE5NDMwOF19fQ==`, outcome: rejected, diagnostic: out-of-range})
(tag-embedding-dtype-i32:TagCase {name: "unsupported integer dtype I32", value: embedding`PgAAAAAAAAB7ImVtYmVkZGluZyI6eyJkdHlwZSI6IkkzMiIsInNoYXBlIjpbMl0sImRhdGFfb2Zmc2V0cyI6WzAsOF19fQAAgD8AAADA`, outcome: rejected, diagnostic: unsupported})
(tag-embedding-dtype-f8:TagCase {name: "unsupported float8 dtype", value: embedding`QgAAAAAAAAB7ImVtYmVkZGluZyI6eyJkdHlwZSI6IkY4X0U0TTMiLCJzaGFwZSI6WzJdLCJkYXRhX29mZnNldHMiOlswLDJdfX0AAA==`, outcome: rejected, diagnostic: unsupported})
