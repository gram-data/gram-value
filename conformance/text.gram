// TextCase: writing `value` as gram text gives exactly `canonical` (ADR-001 2.4, spec/text.md).

(text-integer-hex:TextCase {name: "hexadecimal is written in decimal", value: 0x10, canonical: "16"})
(text-integer-octal:TextCase {name: "octal is written in decimal", value: 010, canonical: "8"})
(text-integer-negative-zero:TextCase {name: "negative zero integer", value: -0, canonical: "0"})
(text-integer-big:TextCase {name: "a big integer", value: 9223372036854775808, canonical: "9223372036854775808"})
(text-decimal-trailing:TextCase {name: "trailing zeros are dropped", value: 1.50, canonical: "1.5"})
(text-decimal-whole:TextCase {name: "a whole decimal keeps a digit after the point", value: 2.00, canonical: "2.0"})
(text-decimal-negative-zero:TextCase {name: "negative zero", value: -0.0, canonical: "-0.0"})
(text-decimal-large:TextCase {name: "no exponent", value: 1000000000000000000000.0, canonical: "1000000000000000000000.0"})
(text-decimal-small:TextCase {name: "no exponent for small values", value: 0.0000001, canonical: "0.0000001"})
(text-decimal-big:TextCase {name: "a big decimal keeps its digits", value: 0.100000000000000000010, canonical: "0.10000000000000000001"})
(text-boolean:TextCase {name: "a boolean", value: true, canonical: "true"})
(text-string-bare:TextCase {name: "a word is bare", value: "active", canonical: "active"})
(text-string-hyphen:TextCase {name: "a hyphen is allowed in a bare word", value: 'a-b', canonical: "a-b"})
(text-string-space:TextCase {name: "a space needs quotes", value: 'Ada Lovelace', canonical: "\"Ada Lovelace\""})
(text-string-true:TextCase {name: "the word true is quoted", value: "true", canonical: "\"true\""})
(text-string-empty:TextCase {name: "the empty string", value: '', canonical: "\"\""})
(text-string-digit-first:TextCase {name: "a leading digit needs quotes", value: "1a", canonical: "\"1a\""})
(text-string-escapes:TextCase {name: "escapes", value: "a\"b\\c\nd\te", canonical: "\"a\\\"b\\\\c\\nd\\te\""})
(text-string-slash:TextCase {name: "the slash is not escaped", value: "a\/b", canonical: "\"a/b\""})
(text-string-fenced:TextCase {name: "a fenced string is written quoted", value: ```
two
lines```, canonical: "\"two\\nlines\""})
(text-tagged:TextCase {name: "a tagged string", value: date`2024-01-15`, canonical: "date`2024-01-15`"})
(text-tagged-backtick:TextCase {name: "a backtick in content", value: x`a\`b`, canonical: "x`a\\`b`"})
(text-measurement-integer:TextCase {name: "an integer magnitude", value: 5kg, canonical: "5kg"})
(text-measurement-decimal:TextCase {name: "a decimal magnitude keeps its point", value: 5.0kg, canonical: "5.0kg"})
(text-measurement-negative:TextCase {name: "a negative decimal magnitude", value: -2.5m, canonical: "-2.5m"})
(text-range-closed:TextCase {name: "a closed range", value: 1..5, canonical: "1..5"})
(text-range-measurements:TextCase {name: "a range of measurements", value: 1.5m..2m, canonical: "1.5m..2m"})
(text-range-open-upper:TextCase {name: "no upper end", value: 1..., canonical: "1..."})
(text-range-open-lower:TextCase {name: "no lower end", value: ...5, canonical: "...5"})
(text-array:TextCase {name: "an array", value: [1,2], canonical: "[1, 2]"})
(text-array-empty:TextCase {name: "the empty array", value: [], canonical: "[]"})
(text-map-sorted:TextCase {name: "keys are in byte order", value: {b: 1, a: [1,2]}, canonical: "{a: [1, 2], b: 1}"})
(text-map-quoted-key:TextCase {name: "a key that is not a symbol is quoted", value: {"a b": 1}, canonical: "{\"a b\": 1}"})
