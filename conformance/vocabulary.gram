// The names a conformance case may use (ADR-001 2.5). A name not listed here is an error.

// Value kinds (ADR-002 2.2).
(integer:Kind)
(big_integer:Kind)
(decimal:Kind)
(big_decimal:Kind)
(boolean:Kind:TypeScriptNative)
(string:Kind:TypeScriptNative:GoNative)
(tagged:Kind)
(range:Kind)
(measurement:Kind)
(array:Kind)
(map:Kind:GoNative)

// Diagnostic codes (spec/results.md).
(invalid-form:Diagnostic)
(out-of-range:Diagnostic)

// Outcomes of a TagCase.
(accepted:Outcome)
(rejected:Outcome)

// Known tags (ADR-004). Loss kinds and native type names are added with the host mappings (RFC-002).
(date:Tag)
(time:Tag)
(localtime:Tag)
(datetime:Tag)
(localdatetime:Tag)
(duration:Tag)
(point:Tag)
(uuid:Tag)
(week:Tag)
(weekDate:Tag)

// Mapping entries (ADR-006). Loss kinds, entry classes and the languages a case may name.
(precision:Loss)
(kind:Loss)
(exact:Class)
(lossy:Class)
(unsupported:Class:Diagnostic)
(rust:Language)
(go:Language)
(typescript:Language)
(python:Language)

// More diagnostic codes (ADR-006 2.10).
(type-mismatch:Diagnostic)
(not-finite:Diagnostic)

// Rust native type names. `none` means no native value: the entry is unsupported.
(none:RustNative:TypeScriptNative:PythonNative:GoNative)
(i8:RustNative)
(i16:RustNative)
(i32:RustNative)
(i64:RustNative)
(i128:RustNative)
(isize:RustNative)
(u8:RustNative)
(u16:RustNative)
(u32:RustNative)
(u64:RustNative)
(u128:RustNative)
(usize:RustNative)
(f64:RustNative)
(bool:RustNative:PythonNative:GoNative)
(String:RustNative)
(Vec:RustNative)
(BTreeMap:RustNative)
(Tagged:RustNative:TypeScriptNative:PythonNative:GoNative)
(Range:RustNative:TypeScriptNative:PythonNative:GoNative)
(Measurement:RustNative:TypeScriptNative:PythonNative:GoNative)
(Date:RustNative:TypeScriptNative:PythonNative:GoNative)
(Time:RustNative:TypeScriptNative:PythonNative:GoNative)
(DateTime:RustNative:TypeScriptNative:PythonNative:GoNative)
(Duration:RustNative:TypeScriptNative:PythonNative:GoNative)
(Point:RustNative:TypeScriptNative:PythonNative:GoNative)
(Uuid:RustNative:TypeScriptNative:PythonNative)
(Week:RustNative:TypeScriptNative:PythonNative:GoNative)

// TypeScript native type names (`none`, `string`, `boolean` and the package types are shared above).
(number:TypeScriptNative)
(bigint:TypeScriptNative)
(Array:TypeScriptNative)
(object:TypeScriptNative)

// Python native type names (`none`, `bool` and the package types are shared above).
(int:PythonNative)
(float:PythonNative)
(Decimal:PythonNative)
(str:PythonNative)
(list:PythonNative)
(dict:PythonNative)

// Statuses of a result (ADR-001 2.7).
(passed:Status)
(failed:Status)
(skipped:Status)
(not-applicable:Status)

// Go native type names (`none`, `bool`, `string`, `map` and the package types are shared above).
(int64:GoNative)
(BigInt:GoNative)
(float64:GoNative)
(slice:GoNative)
(UUID:GoNative)
